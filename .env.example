# Copy this file to .env and fill in the values. NEVER commit .env.
# Option 1 - ModelAPI / Codex-compatible OpenAI endpoint:
MODELAPI_API_KEY=
MODELAPI_MODEL=gpt-6.1-sol
# MODELAPI_BASE_URL=https://modelapi.vn/v1
# MODELAPI_TOP_P=1
# MODELAPI_MAX_TOKENS=2048
# MODELAPI_TIMEOUT=60
# MODELAPI_MAX_RETRIES=1

# Option 2 - NVIDIA NIM / OpenAI-compatible endpoint:
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_TOP_P=0.95
# NVIDIA_MAX_TOKENS=2048
# NVIDIA_TIMEOUT=45
# NVIDIA_MAX_RETRIES=0

# Option 3 - Azure OpenAI or another OpenAI-compatible gateway (give all three):
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT_MODEL=
# AZURE_OPENAI_API_VERSION=2024-12-01-preview   # only for real *.openai.azure.com endpoints

# Option 4 - another provider (leave Options 1, 2, and 3 empty):
# LAB_MODEL=deepseek:deepseek-chat
# DEEPSEEK_API_KEY=

LAB_TEMPERATURE=0
